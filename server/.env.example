# ── Cup Tasters admin · copy to .env and fill in ─────────────────────────────
APP_NAME="Cup Tasters Admin"

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cup_tasters
DB_USER=cup_tasters
DB_PASS=change-me

# Extra origins allowed to call the API (same-site requests are always allowed).
ALLOWED_ORIGINS=http://localhost:5173,https://cuptasters.com.np

# Max upload size for profile photos, in MB.
MAX_PHOTO_MB=5
